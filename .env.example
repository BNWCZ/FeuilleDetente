# Identifiants PeopleSoft
# Copiez ce fichier en « .env » et renseignez vos informations.
# Le fichier .env est ignoré par git (voir .gitignore) : ne le committez jamais.

# Identifiant et mot de passe PeopleSoft
UID=prenom.nom
PASSWORD=votre_mot_de_passe

# URL de connexion au portail PeopleSoft (demandez-la a votre equipe si besoin)
LOGIN_URL=https://votre-portail-peoplesoft.exemple.com/psp/<site>/?cmd=login&languageCd=CFR
